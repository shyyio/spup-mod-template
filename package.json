{
    "name": "spup-mod-template",
    "version": "1.0.0",
    "private": true,
    "description": "A starting point for a Shy's Power-Up Factory mod",
    "type": "module",
    "scripts": {
        "build": "spup-mod-builder build . dist --version 1.0.0",
        "check": "spup-mod-builder check dist",
        "test": "node --import @spup/mod-builder/test-loader --test *.spec.js"
    },
    "devDependencies": {
        "@spup/mod-builder": "^1.0.0"
    },
    "engines": {
        "node": ">=20"
    }
}
